{
  "name": "creatorflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12 <23 || >=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "ts-node --project apps/api/tsconfig.json apps/api/src/main.ts",
    "dev:web": "npm run dev --workspace apps/web",
    "worker": "ts-node --project apps/api/tsconfig.json apps/api/src/worker.ts",
    "build": "npm run db:generate && npm run build:api && npm run build:web",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:web": "npm run build --workspace apps/web",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "ts-node --project apps/api/tsconfig.json scripts/seed.ts",
    "db:local": "tsx scripts/local-postgres.ts",
    "mailbox": "ts-node --project apps/api/tsconfig.json scripts/mailbox.ts",
    "test": "jest --runInBand && npm run test:proxy",
    "test:e2e": "playwright test",
    "test:integration": "jest --runInBand --testPathPattern=integration",
    "admin:create": "ts-node --project apps/api/tsconfig.json scripts/admin.ts",
    "admin:local": "ts-node --project apps/api/tsconfig.json scripts/admin-local.ts",
    "db:demo": "ts-node --project apps/api/tsconfig.json scripts/demo.ts",
    "dev:local": "node scripts/dev-local.cjs",
    "worker:local": "ts-node --project apps/api/tsconfig.json scripts/local-worker.ts",
    "format": "prettier --write apps scripts tests docs *.ts *.cjs *.json *.yml README.md",
    "email:worker": "ts-node --project apps/api/tsconfig.json scripts/email-worker.ts",
    "email:check": "ts-node --project apps/api/tsconfig.json scripts/email-check.ts",
    "test:proxy": "tsx --test tests/api-proxy.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/client-sesv2": "3.1155.0",
    "@aws-sdk/s3-request-presigner": "3.1155.0",
    "@hookform/resolvers": "5.2.2",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.104.5",
    "@xyflow/react": "12.12.0",
    "argon2": "0.45.1",
    "bullmq": "6.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.8",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "react-hook-form": "7.90.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "23.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-socket": "0.2.14",
    "@nestjs/testing": "12.2.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.15",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.6",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
