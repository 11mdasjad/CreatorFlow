{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "npm run build",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "CREATORFLOW_API_URL"
        }
      ]
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }]
}
