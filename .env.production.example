NODE_ENV=production
APP_URL=https://creatorflow.example.com
API_HOST=0.0.0.0
API_PORT=4000
API_INTERNAL_URL=http://api:4000
DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_RDS_HOST:5432/creatorflow?sslmode=verify-full
DATABASE_POOL_MAX=10
REDIS_URL=rediss://USER:PASSWORD@PRIVATE_REDIS_HOST:6379
SESSION_DAYS=7
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
ADMIN_ACTION_KEY=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET
EMAIL_PROVIDER=ses
EMAIL_FROM=CreatorFlow <hello@your-verified-domain.example>
AWS_REGION=ap-south-1
S3_BUCKET=your-private-bucket
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
META_REDIRECT_URI=https://creatorflow.example.com/api/integrations/instagram/callback
META_APPROVED=false
META_PRIVATE_REPLY_POLICY_VERIFIED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
PAYMENTS_ENABLED=false
BILLING_ENABLED=false
STRIPE_CONNECT_COUNTRIES=
MERCHANT_COUNTRY=
NEXT_TELEMETRY_DISABLED=1
